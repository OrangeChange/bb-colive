{
  "name": "bb-colive",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:detached": "wscript.exe //B //NoLogo scripts/start-dev-detached.vbs",
    "build": "npm run themes:prepare && node scripts/build-laplace-product.mjs && node scripts/package-license-notices.mjs && tsc && vite build",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "themes:prepare": "node --experimental-transform-types scripts/prepare-native-themes.mjs && node --experimental-transform-types scripts/materialize-builtin-themes.mjs",
    "predev": "npm run themes:prepare && node scripts/build-laplace-product.mjs",
    "translations:export": "node scripts/export-ui-translations.mjs",
    "licenses:collect": "node scripts/collect-third-party-notices.mjs",
    "pretest": "npm run themes:prepare"
  },
  "dependencies": {
    "@laplace.live/ws": "^8.0.4",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.3.7",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.4",
    "fflate": "^0.8.3",
    "js-md5": "^0.9.2",
    "lucide-react": "1.73.0",
    "monaco-editor": "^0.54.0",
    "motion": "^13.1.1",
    "postcss": "^8.5.31",
    "postcss-safe-parser": "^7.1.0",
    "postcss-value-parser": "^4.2.0",
    "prettier": "^3.9.10",
    "protobufjs": "^8.7.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.1.0",
    "video-animation-player": "1.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
