{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BB CoLive",
  "version": "1.1.0",
  "identifier": "orange.bbcolive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BB CoLive",
        "width": 960,
        "height": 720,
        "decorations": false,
        "resizable": true,
        "url": "index.html",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "style-distribution/": "style/",
      "../licenses/distribution/": "licenses/"
    },
    "publisher": "橙橙子君（Orange）",
    "copyright": "Copyright © 2026 橙橙子君（Orange）",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
