# 统一换行符处理，避免 Windows CRLF/LF 混乱
* text=auto

# 强制 LF（跨平台脚本与配置）
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 脚本保留 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# 二进制
*.png binary
*.ico binary
*.icns binary

# 固定来源与生成许可文件保持原始 LF 字节
vendor/blivechat/upstream/**/*.vue text eol=lf
public/laplace/**/renderer.js.LEGAL.txt text eol=lf
licenses/distribution/THIRD_PARTY_NOTICES.txt whitespace=-blank-at-eol

